{
    "name": "zerofront/module-zero-size-chart",
    "description": "Zero for Magento Open Source: size guides on product pages: tables made in the admin, shown by category or per product in a dialog.",
    "type": "magento2-module",
    "version": "1.3.6",
    "license": [
        "OSL-3.0",
        "AFL-3.0"
    ],
    "authors": [
        {
            "name": "Roman Pasichnyk"
        }
    ],
    "homepage": "https://zerofront.dev",
    "keywords": [
        "magento",
        "magento2",
        "magento-open-source",
        "zero",
        "size-chart",
        "size-guide"
    ],
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0",
        "magento/framework": "103.0.*",
        "magento/module-backend": "*",
        "magento/module-catalog": "*",
        "magento/module-config": "*",
        "magento/module-eav": "*",
        "magento/module-store": "*",
        "zerofront/module-zero-core": "^1.3.6"
    },
    "replace": {
        "fixstacks/module-zero-size-chart": "self.version"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Zero\\SizeChart\\": ""
        }
    }
}
